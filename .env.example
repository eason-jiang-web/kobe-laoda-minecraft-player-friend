# ──────────────────────────────────────────────────────────────
# itto — environment config. Copy to .env and fill in.
# ──────────────────────────────────────────────────────────────

# ── Minecraft server the bot connects to ──
# Playing a world you launched from PCL (Plain Craft Launcher)? Open the world,
# press Esc -> "Open to LAN", type 25565 as the port, allow cheats, then start
# the bot. Walkthrough: docs/PCL_DEEPSEEK_SETUP.md
MC_SERVER_HOST=127.0.0.1
MC_SERVER_PORT=25565
# MUST match the version you launched in PCL, exactly.
MC_VERSION=1.20.6
# The username the bot logs in as. Minecraft names are ASCII only (3-16 chars,
# letters/digits/underscore), so a character with a non-Latin name needs both:
# the persona name in the prompt, and a username the server accepts here.
MC_BOT_USERNAME=Laoda
# Comma-separated words that count as "the player is talking to me" (the bot's
# own username is always included). Chinese/emoji are fine — this is chat, not
# a login name. Default: itto,牢大,曼巴
MC_WAKE_WORDS=牢大,老大,肘,曼巴
# "offline" for cracked/LAN dev servers, "microsoft" for real accounts.
MC_AUTH=offline
# Only needed when MC_AUTH=microsoft (leave blank for offline mode).
MC_BOT_EMAIL=
# Username of the human the bot should follow + listen to. Hard commands
# (#back, #free, ...) only work from this player.
MC_OWNER_USERNAME=
# Where Minecraft actually keeps this world. Two things use it:
#   1. `bun run op:bot` (the "给牢大开权限.cmd" double-click) writes the bot into
#      ops.json without you typing /op in-game.
#   2. The bot reads the game's own Chinese language file (assets/.../zh_cn.json)
#      so item names in its "eyes" are 橡木原木 instead of oak_log.
# PCL with 版本隔离 ON puts the world under versions/<version>/.
# Leave blank to auto-detect (running game's --gameDir, then a scan).
MC_GAME_DIR=

# ── MCP server (what Hermes connects to) ──
# Hermes registers this: `hermes mcp add itto http://localhost:3001`
MCP_PORT=3001
MCP_HOST=0.0.0.0

# ── Model: DeepSeek (the built-in brain, apps/brain-deepseek) ──
DEEPSEEK_API_KEY=
# 模型名必须是 API 认的（2026-10 实测：只认 deepseek-flash 和 deepseek-v4-pro）。
# 两个都支持工具调用 —— 机器人靠工具干活，模型不支持工具就只会聊天不会动手。
#
# 实测（同样的 6000 字上下文，同一台机器，各 4 次）：
#   deepseek-flash    每次调用 ~1.0 秒
#   deepseek-v4-pro   每次调用 ~5.0 秒（关掉深度思考也一样慢）
# 一次唤醒要调 3~4 次模型 -> 用 pro 时一次唤醒 15~20 秒，游戏里看着就像"它不动了"。
#
# 所以**两个一起用**：
#   DEEPSEEK_MODEL     聪明模型：它自己闲着琢磨时用（慢一点没关系）
#   BRAIN_FAST_MODEL   快模型：有人在跟你说话 / 有危险时用（等不起）
# 只想要一个模型：把两个填成一样，或者把 BRAIN_FAST_MODEL 留空。
# （deepseek-chat 是别名，会被路由到 deepseek-flash；写全名更明确。）
DEEPSEEK_MODEL=deepseek-v4-pro
BRAIN_FAST_MODEL=deepseek-flash
# 深度思考（reasoning）。默认 false —— **别开**，实测真实对局里：
#   开：平均 25.7 秒一次唤醒，最慢 116.8 秒（玩家只会觉得"它不动了"）
#   关：平均 9~11 秒（同样的工具调用能力，4 步里能真的动手）
# 想要更聪明的判断可以设 true，但游戏是实时的，开了会明显迟钝。
BRAIN_THINKING=false
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Model: Claude via Hermes (only if you use Hermes instead of the above) ──
ANTHROPIC_API_KEY=

# ── MCP 地址（开发工具用）──
# scripts/drive.ts 这类开发工具靠它连机器人。
ITTO_MCP_URL=http://localhost:3001/mcp

# ── Brain：会不会跟你说话，全看这一节 ──
# 开着 = 它会回你话、会自己拿主意（每次唤醒 = 一次 DeepSeek 调用，用上面那个 key）。
# 关掉 = 照样进游戏、跟着你走、听 #指令，但**一句话都不说** —— 看着完全像坏了。
# 所以默认就是开着的，照 README 走不用动这两行。
BRAIN_ENABLED=true
# 内置的 DeepSeek 大脑（推荐，不用额外装任何东西）—— 默认就是这一行。
# BRAIN_CMD 按空格拆开、提示词作为最后一个参数追加，所以命令本身别带空格；
# 路径里有空格的放 BRAIN_DIR。
BRAIN_CMD=bun apps/brain-deepseek/src/index.ts
# 大脑的工作目录。留空 = 仓库根目录（从仓库里启动就什么都不用填）。
BRAIN_DIR=
# 想换成别的 agent（Claude / Hermes / 你自己的脚本）也行：任何「把提示词当
# 最后一个参数、连得上 itto-mc (:3001)、会用 chat 工具回话」的命令都可以，
# 把上面两行换成你的 BRAIN_CMD / BRAIN_DIR 即可。
# Min ms between agent spawns (each is a full model run). A nudge that lands
# while the brain is busy is queued (newest wins), not dropped.
BRAIN_COOLDOWN_MS=10000
# Shorter cooldown for "a human is talking to you" nudges, so replies feel live
# instead of landing after the ambient cooldown has passed.
BRAIN_CHAT_COOLDOWN_MS=1500
# Training data: every wake appends one JSONL line (what happened -> tools it
# called + their real results -> what it said) to data/training/. Player
# feedback comes from the in-game #good / #bad commands. Export with
# `bun run train:export`.
BRAIN_TRAIN_LOG=1
# Also store the full prompt with each turn (complete training pairs, big files).
BRAIN_TRAIN_FULL=0
# Where those files live.
BRAIN_TRAIN_DIR=data/training

# ── Reconnect (Minehut sleeps + kicks idle bots, so auto-rejoin) ──
RECONNECT_ENABLED=true
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000

# ── Tuning ──
FAST_LOOP_HZ=15
SLOW_LOOP_INTERVAL_MS=4000
FOLLOW_TARGET_RANGE=3
# How far away a target can be before we stop pathfinding and just /tp to it.
# Requires the bot to be server op. 0 = never teleport (walks everywhere; no op
# needed, but long trips are slow and can get stuck on terrain).
TELEPORT_FALLBACK_DISTANCE=30
# How often (ms) to wake the brain to reassess even if nothing happened (0 = off).
# Keep modest — each beat is a brain turn. Event triggers fire regardless.
#
# **任务正在跑的时候不会触发**：做完了 goal-runner 自己会叫醒它来汇报。
# 中途也叫只会逼出一句「还在跑，不吭声」（实测就是这么刷屏的）。
HEARTBEAT_MS=30000
# Inventory milestones: when the pile crosses a threshold the bot tells you about
# it, once (it re-arms if you stash/spend the items). Comma list of
# <thing>:<count>, where <thing> is an item id or a group:
#   any_log  logs/wood/stems      any_ore  ores + raw drops      rare  diamonds,
#   emeralds, ancient debris, netherite, lapis, amethyst, quartz, gold
# e.g. MC_REPORT_ITEMS=any_log:128,diamond:10,ancient_debris:3
MC_REPORT_ITEMS=any_log:128,rare:10
# Answer everything the owner types, not only lines that name the bot. On a LAN
# world there are only two of you, so "he said something" means "he's talking
# to you". Other players still have to name you.
MC_CHAT_REPLY_ALL=false
# Autoplay: when nothing is happening, nobody is talking and no goal is running,
# wake the brain with "go find something useful to do" (chop / mine / scout /
# build) instead of a plain heartbeat. Same cost as a heartbeat.
MC_AUTOPLAY=false
# Which server commands the bot may run through the chat bar (needs op).
# Empty = the safe default set (time, weather, say, me, list, seed, difficulty,
# summon, give). "*" = everything, which also means /fill can flatten your base
# and /stop can kill the server — only do that if you mean it.
MC_ALLOW_COMMANDS=
# On startup the bot sends one `/op <itself>`. A player cannot op itself, so
# this is refused by design — the point is what happens next: the bot says one
# line IN-GAME telling you the two real fixes (type /op once, or shut the world
# and double-click 给牢大开权限.cmd). Set false to keep it quiet.
MC_SELF_OP=true
# Where the self-study notes live (bun run study:wiki). The brain reads the digest
# from here into its system prompt (stable prefix -> cached), and the wiki_notes
# tool reads the rest on demand.
# BRAIN_WIKI_NOTES_PATH=data/wiki/notes.json
# 边玩边学攒下来的画像摘要（他的习惯 + 你的熟练度 + 教训）：身体写、大脑读。
# 看不懂就删掉它 —— 下次身体记账时会自己重建。
# BRAIN_PROFILE_PATH=data/profile-digest.txt
# Where "#value 铁 400" overrides are stored (default data/value-caps.json).
# MC_VALUE_CAPS_FILE=data/value-caps.json
LOG_LEVEL=info
